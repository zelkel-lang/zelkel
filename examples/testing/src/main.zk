#llvm(
    #"@int.fmt = private unnamed_addr constant [5 x i8] c"%ld\0A\00""#
)

#llvm(
    #"declare i32 @printf(ptr, ...)"#
)

fn main() -> void {
    val test: i64 = 2 + 2*3
    
    #llvm(
        "%call = call i32 (ptr, ...) @printf(ptr @int.fmt, i64 %v_27_test)"
    )
    
    #llvm(
        "ret void"
    )
    
    return
}