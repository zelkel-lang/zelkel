#llvm(
    #"@int.fmt = private unnamed_addr constant [14 x i8] c"Integer: %ld\0A\00""#
)

#llvm(
    #"@float.fmt = private unnamed_addr constant [12 x i8] c"Float: %lf\0A\00""#
)

#llvm(
    "declare i32 @printf(ptr, ...)"
)

fn test() -> i64 {
    return 12 + 2
}

fn main() -> void {
    val test: i64 = 123 * 2
    val test2: f64 = 5.0 * 0.5 + 2.0

    #llvm(
        "%call = call i32 (ptr, ...) @printf(ptr @int.fmt, i64 %v_42_test)"
    )

    #llvm(
        "%call.2 = call i32 (ptr, ...) @printf(ptr @float.fmt, double %v_52_test2)"
    )
    
    return
}