#llvm(
    #"@int.fmt = private unnamed_addr constant [14 x i8] c"Integer: %ld\0A\00""#
)
#llvm(
    #"@float.fmt = private unnamed_addr constant [12 x i8] c"Float: %lf\0A\00""#
)

#llvm("declare i32 @printf(ptr, ...)")

fn main() -> void {
    val test: i64 = 123
    val test2: f64 = 12.3 + 5.6 * 3.2

    #llvm(
        "%call.{:id} = call i32 (ptr, ...) @printf(ptr @int.fmt, {0:ty} {0})",
        test
    )
    #llvm(
        "%call.{:id} = call i32 (ptr, ...) @printf(ptr @float.fmt, {0:ty} {0})",
        test2
    )
    return
}